# Copy to .env.local and fill in. Every value is optional: without them the app runs fully
# on-device (local-first), with template prayers, a mock billing provider and placeholder ads.

# Firebase (Project settings -> Your apps -> Web app config). Enables sign-in + cloud sync + AI prayers.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# RevenueCat public Android SDK key (Project -> API keys). Enables the real $20/month subscription.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium

# AdMob ad unit IDs (leave empty to use Google's test ads). Also set the AdMob app ID in app.json.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# Links shown on the paywall and in Settings.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
